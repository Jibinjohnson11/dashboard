# Copy to .env and fill in. Never commit .env.

# --- Django core ---
DJANGO_ENV=development              # development | production
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Django auth/session database. Defaults to SQLite (db.sqlite3) when empty.
# Production example: postgres://user:password@host:5432/seo_dashboard
DATABASE_URL=
# Neon: `neon env pull` writes DATABASE_URL (pooled, used by the app) and
# DATABASE_URL_UNPOOLED (direct, used by migrate/createcachetable).
DATABASE_URL_UNPOOLED=
# Overrides the URL's sslmode; verify-full checks Neon's certificate against certifi's CA bundle.
DATABASE_SSLMODE=verify-full

# --- MongoDB (business data) ---
MONGODB_URI=mongodb://127.0.0.1:27017
# Atlas example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=seo_dashboard
# Development only: true = use an in-memory MongoDB (data is lost on restart).
MONGODB_USE_MOCK=false
MONGODB_TIMEOUT_MS=5000

# --- Registration policy ---
# open_pending: public sign-up creates a pending account that an admin activates.
# invite_only:  public sign-up is disabled; admins invite users from Team.
REGISTRATION_MODE=open_pending

# --- Email ---
# Development: console backend prints emails (including reset links) to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=SEO Dashboard <no-reply@example.com>

# --- Sessions & security ---
SESSION_COOKIE_AGE_SECONDS=28800        # 8 hours
REMEMBER_ME_AGE_SECONDS=1209600         # 14 days
PASSWORD_RESET_TIMEOUT_SECONDS=3600     # 1 hour
INVITE_TOKEN_TIMEOUT_SECONDS=259200      # 72 hours (admin invitations)
LOGIN_RATE_LIMIT=5                      # failed attempts per window, per email and per IP
LOGIN_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
# Set to true behind a TLS-terminating proxy that sets X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=false
# Comma-separated, use the proxy's trusted header for client IPs only if set.
DJANGO_TRUST_X_FORWARDED_FOR=false

# Cache used by rate limiting. Use "db" in production (run createcachetable) so all workers share counters.
CACHE_BACKEND=locmem                    # locmem | db

# Brand logo uploads are stored here (outside static files; served only to signed-in users).
MEDIA_ROOT=
BRAND_LOGO_MAX_BYTES=2097152

LOG_LEVEL=INFO
