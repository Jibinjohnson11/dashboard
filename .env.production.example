# Production template. Set these in your host's environment / secret manager — never commit real values.
DJANGO_ENV=production
DJANGO_SECRET_KEY=                       # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=seo.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seo.example.com
DJANGO_BEHIND_PROXY=true                 # when TLS terminates at a load balancer that sets X-Forwarded-Proto
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_PRELOAD=false                # only after confirming every subdomain serves HTTPS

DATABASE_URL=postgres://seo_user:CHANGE_ME@db.example.com:5432/seo_dashboard
MONGODB_URI=mongodb+srv://seo_app:CHANGE_ME@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=seo_dashboard

REGISTRATION_MODE=invite_only
CACHE_BACKEND=db                         # shared rate-limit counters across gunicorn workers

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SEO Dashboard <no-reply@example.com>

LOG_LEVEL=INFO
